# ==============================================================================
# 🏪 GreenCard — Seller Microservice Template (.env.example)
# ==============================================================================
NODE_ENV=production
PORT=5002
SELLER_SERVICE_PORT=5002

# MongoDB Atlas seller_db connection string
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/seller_db?retryWrites=true&w=majority

ACCESS_TOKEN_SECRET=your_jwt_access_secret
REFRESH_TOKEN_SECRET=your_jwt_refresh_secret
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_EXPIRY=10d

INTERNAL_API_SECRET=your_internal_cluster_shared_secret

USER_BACKEND_INTERNAL_URL=https://greencards-user-backend.onrender.com
SUPERADMIN_BACKEND_INTERNAL_URL=https://greencards-superadmin-backend.onrender.com

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
